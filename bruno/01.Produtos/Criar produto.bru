meta {
  name: Criar produto
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/produtos
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nome": "CDB Banco Inter 120% CDI",
    "tipo": "CDB",
    "emissor": "Banco Inter",
    "classificacaoEmissor": "AA+",
    "taxaAnual": 13.5,
    "investimentoMinimo": 100.00,
    "prazoMeses": 12,
    "ativo": true
  }
}

assert {
  res.status: eq 201
  res.body.sucesso: eq true
}

script:post-response {
  if (res.body && res.body.dados) {
    bru.setVar("produtoId", res.body.dados.id);
  }
}

docs {
  `tipo` aceita CDB, LCI ou LCA. Guarda o `id` retornado em `produtoId`
  para os demais requests desta pasta e para Aplicacoes/Solicitar
  aplicacao.
}
