meta {
  name: Solicitar aplicacao
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/aplicacoes
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "cpf": "{{contaCpf}}",
    "produtoId": "{{produtoId}}",
    "valor": 300.00
  }
}

assert {
  res.status: eq 202
  res.body.sucesso: eq true
  res.body.dados.status: eq PENDENTE
}

script:post-response {
  if (res.body && res.body.dados) {
    bru.setVar("aplicacaoId", res.body.dados.id);
  }
}

docs {
  Requer Contas/Criar conta e Produtos/Criar produto rodados antes (usa
  `contaCpf` e `produtoId`). A resposta volta com status PENDENTE - o
  debito de saldo e assincrono (fila RabbitMQ); espere ~1s e rode
  Buscar aplicacao para ver virar CONCLUIDA ou FALHOU.
}
